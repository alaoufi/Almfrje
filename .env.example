NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# JWT secret لتوقيع وتحقق tokens المصادقة
JWT_SECRET=alaoufi_secret_2026_x9k2p

# Anthropic (Claude) — لترجمة الصور و PDF تلقائياً إلى العربية
