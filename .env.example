# =============================================================================
#  متغيّرات البيئة — منصّة alaoufi (ثلاثة مشاريع مستقلّة على نشرٍ واحد)
# =============================================================================
#  المستودع يضمّ ثلاثة تطبيقات منفصلة تتشارك نشر Next.js واحداً فقط:
#    • المفرجي (شجرة النسب)     → app/api/almfrje-*   + public/almfrje
#    • منصّة الاستشارات         → app/api/php/*       + public/legacy
#    • مراح (ويب)               → app/api/mrahi-*     + public/mrahi
#
#  العزل الكامل = إعطاء كل تطبيق مشروع Supabase خاصاً به ومتغيّراته الخاصة.
#  إن لم تُضبط متغيّرات تطبيقٍ ما، يرجع تلقائياً للقاعدة المشتركة أدناه
#  (وضعٌ انتقالي فقط). للفصل التام: اضبط متغيّرات كل تطبيق ولا تعتمد على الرجوع.
#  راجع SEPARATION.md لخطوات العزل الكامل ونقل البيانات.
# =============================================================================


# ── (أ) القاعدة المشتركة — رجوعٌ افتراضي فقط (الأفضل تركها فارغة بعد العزل) ──
# تُستخدم حين لا يملك التطبيق متغيّراته الخاصة. للعزل التام: انقل كل تطبيق
# لمتغيّراته في الأقسام (ب)/(ج)/(د) ثم أفرغ هذه أو خصّصها لتطبيقٍ واحد فقط.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-SHARED-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SHARED_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SHARED_ANON_PUBLIC_KEY

# ── النسخ الاحتياطي السحابي المجدول (Vercel Cron → تخزين Supabase) ──
# يحفظ مسار /api/almfrje-backup نسخة كاملة يومياً في دلو خاص (almfrje-backups)،
# ويُبقي آخر 30 نسخة تلقائياً. اختياري لكن مُوصى به: سرٌّ يحمي المسار. حين يُضبط
# CRON_SECRET ترسله Vercel Cron تلقائياً في ترويسة Authorization: Bearer ويُرفض ما عداه.
# ولّد قيمة عشوائية:  openssl rand -base64 32
CRON_SECRET=GENERATE_A_STRONG_RANDOM_SECRET


# ── (ب) المفرجي — شجرة النسب (مصادقة Supabase Auth + RLS) ──
# مشروع Supabase مستقلّ خاص بالمفرجي. ANON علنيّ (يُقدَّم للمتصفّح عبر /api/almfrje-config).
ALMFRJE_SUPABASE_URL=https://YOUR-ALMFRJE-PROJECT.supabase.co
ALMFRJE_SUPABASE_ANON_KEY=YOUR_ALMFRJE_ANON_PUBLIC_KEY
ALMFRJE_SERVICE_ROLE_KEY=YOUR_ALMFRJE_SERVICE_ROLE_KEY
# Personal Access Token لإنشاء الجداول/الـRLS تلقائياً (الخادم فقط — لا يُكشف للمتصفّح).
# يستهدف قاعدة المفرجي وحدها (بلا رجوع) فلا يمسّ المشاريع الأخرى.
ALMFRJE_SUPABASE_PAT=YOUR_ALMFRJE_SUPABASE_PERSONAL_ACCESS_TOKEN


# ── (ج) منصّة الاستشارات (JWT مخصّص HS256 + جداول غير مبوّأة: users/persons…) ──
CON_SUPABASE_URL=https://YOUR-CON-PROJECT.supabase.co
CON_SERVICE_ROLE_KEY=YOUR_CON_SERVICE_ROLE_KEY
# سرّ توقيع رموز الدخول — إلزامي وسرّي. ولّد قيمة عشوائية قوية (≥ 32 محرفاً) ولا
# تُشاركها في أي مستودع. مثال للتوليد:  openssl rand -base64 48
# تحذير: لا تستخدم القيمة القديمة المسرّبة "alaoufi_secret_2026_x9k2p" إطلاقاً.
JWT_SECRET=GENERATE_A_STRONG_RANDOM_SECRET_DO_NOT_COMMIT
# رمز تشغيل الإعداد المُدمِّر /api/setup (يُقدَّم كـ ?token= أو ترويسة X-Setup-Token).
SETUP_TOKEN=GENERATE_A_LONG_RANDOM_SETUP_TOKEN


# ── (د) مراح — ويب (anon + RLS فقط، لا مفتاح خدمي) ──
MRAHI_SUPABASE_URL=https://YOUR-MRAHI-PROJECT.supabase.co
MRAHI_SUPABASE_ANON_KEY=YOUR_MRAHI_ANON_PUBLIC_KEY


# ── (د-٢) الملاحظات notes — alaoufi.me/notes (مشروع مستقلّ) ──
NOTES_SUPABASE_URL=https://YOUR-NOTES-PROJECT.supabase.co
NOTES_SUPABASE_ANON_KEY=YOUR_NOTES_ANON_PUBLIC_KEY
NOTES_SERVICE_ROLE_KEY=YOUR_NOTES_SERVICE_ROLE_KEY


# ── (هـ) Anthropic (Claude) — لترجمة الصور و PDF تلقائياً إلى العربية ──
# أنشئ مفتاحاً من https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# اختياري: تغيير النموذج (الافتراضي claude-haiku-4-5-20251001 — الأرخص والأسرع)
# للجودة الأعلى: claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
